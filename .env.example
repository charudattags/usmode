# ─────────────────────────────────────────────────────────────────────────────
# USMODE environment. Copy to .env.local and fill in.
# Everything prefixed NEXT_PUBLIC_ is shipped to the browser, so only public
# values belong there. With no Supabase values the app runs the local demo.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API). The anon key is safe in the browser: every
# table is locked down by row-level security and only holds ciphertext.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Spotify (developer.spotify.com → your app → Client ID). PKCE flow, no secret.
# Add <your-origin>/spotify-callback as a Redirect URI in the Spotify app.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Web Push public key (generate a pair with: npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Show the "two-tab demo" entry on the sign-in screen. Set to false in production
# if you don't want it.
NEXT_PUBLIC_ENABLE_DEMO=true

# ─────────────────────────────────────────────────────────────────────────────
# Server-only secrets. Do NOT put these in .env.local for the web app.
# Set them on the Supabase Edge Function instead:
#   supabase secrets set WEBHOOK_SECRET=... VAPID_PUBLIC_KEY=... \
#     VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
# ─────────────────────────────────────────────────────────────────────────────

# Only for `npm run test:sql` (a Postgres where throwaway databases can be created).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
